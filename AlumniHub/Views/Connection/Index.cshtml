@model AlumniHub.Models.ConnectionIndexViewModel
@{
    ViewData["Title"] = "Networking & Connections";
    int unreadCount = Model.MyConnections.Count(c => c.City == "new_msg");
}

<div class="container mt-4">

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Navigation Tabs -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <ul class="nav nav-pills nav-fill" id="networkTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(Model.ActiveTab == "directory" ? "active" : "") fw-bold"
                       asp-action="Index" asp-route-tab="directory">
                        🔍 Browse Directory (@Model.DirectoryMembers.Count)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.ActiveTab == "requests" ? "active" : "") fw-bold"
                       asp-action="Index" asp-route-tab="requests">
                        📥 Requests
                        @if (Model.PendingReceivedRequests.Any())
                        {
                            <span class="badge bg-danger ms-1">@Model.PendingReceivedRequests.Count</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.ActiveTab == "connections" ? "active" : "") fw-bold"
                       asp-action="Index" asp-route-tab="connections">
                        👥 My Connections (@Model.MyConnections.Count)
                        @if (unreadCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@unreadCount New</span>
                        }
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- TAB 1: BROWSE DIRECTORY -->
    @if (Model.ActiveTab == "directory")
    {
        <!-- Search Bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <form method="get" asp-action="Index">
                    <input type="hidden" name="tab" value="directory" />
                    <div class="input-group">
                        <input type="text" name="search" class="form-control"
                               placeholder="Search by name, department, company..."
                               value="@Model.SearchTerm" />
                        <button class="btn btn-primary px-4" type="submit">Search</button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Index" asp-route-tab="directory" class="btn btn-outline-secondary">Clear</a>
                        }
                    </div>
                </form>
            </div>
        </div>

        @if (!Model.DirectoryMembers.Any())
        {
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <div style="font-size: 50px;">🔍</div>
                    <h5 class="text-muted mt-2">No members found</h5>
                    <p class="text-muted small">Try searching with a different term.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var member in Model.DirectoryMembers)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card shadow-sm border-0 h-100 text-center p-3">
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(member.ProfileImage))
                                {
                                    <img src="/uploads/@member.ProfileImage" class="rounded-circle border mb-3"
                                         style="width: 80px; height: 80px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle @(member.Role == "Student" ? "bg-primary" : "bg-dark") text-white d-inline-flex align-items-center justify-content-center mb-3"
                                         style="width: 80px; height: 80px; font-size: 28px; font-weight: bold;">
                                        @(member.FullName.Length > 0 ? member.FullName.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                }

                                <h5 class="fw-bold mb-1">@member.FullName</h5>
                                <span class="badge @(member.Role == "Student" ? "bg-primary" : "bg-dark") mb-2">@member.Role</span>

                                <p class="text-muted small mb-1">@member.Department</p>
                                @if (!string.IsNullOrEmpty(member.Details))
                                {
                                    <p class="text-secondary small fw-semibold mb-1">@member.Details</p>
                                }
                            </div>

                            <div class="card-footer bg-transparent border-0 pt-0">
                                @if (member.ConnectionStatus == "Connected")
                                {
                                    <span class="badge bg-success py-2 px-3 w-100">✅ Connected</span>
                                }
                                else if (member.ConnectionStatus == "PendingSent")
                                {
                                    <span class="badge bg-secondary py-2 px-3 w-100">⏳ Request Sent</span>
                                }
                                else if (member.ConnectionStatus == "PendingReceived")
                                {
                                    <div class="d-flex gap-2">
                                        <form asp-action="AcceptRequest" method="post" class="w-50">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="connectionId" value="@member.ConnectionId" />
                                            <button type="submit" class="btn btn-sm btn-success w-100">Accept</button>
                                        </form>
                                        <form asp-action="RejectRequest" method="post" class="w-50">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="connectionId" value="@member.ConnectionId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Decline</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <form asp-action="SendRequest" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="receiverId" value="@member.UserId" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100">
                                            🤝 Connect
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- TAB 2: REQUESTS -->
    @if (Model.ActiveTab == "requests")
    {
        <div class="row">
            <!-- Received Requests -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold">📥 Incoming Requests (@Model.PendingReceivedRequests.Count)</h6>
                    </div>
                    <div class="card-body">
                        @if (!Model.PendingReceivedRequests.Any())
                        {
                            <p class="text-muted text-center py-4 mb-0">No pending incoming requests.</p>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var req in Model.PendingReceivedRequests)
                                {
                                    <div class="p-3 border rounded d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="mb-0 fw-bold">@req.FullName</h6>
                                            <small class="badge @(req.Role == "Student" ? "bg-primary" : "bg-dark")">@req.Role</small>
                                            <small class="text-muted ms-1">@req.Department</small>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <form asp-action="AcceptRequest" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="connectionId" value="@req.ConnectionId" />
                                                <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                            </form>
                                            <form asp-action="RejectRequest" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="connectionId" value="@req.ConnectionId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Decline</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Sent Requests -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold">📤 Sent Requests (@Model.PendingSentRequests.Count)</h6>
                    </div>
                    <div class="card-body">
                        @if (!Model.PendingSentRequests.Any())
                        {
                            <p class="text-muted text-center py-4 mb-0">No pending sent requests.</p>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var req in Model.PendingSentRequests)
                                {
                                    <div class="p-3 border rounded d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="mb-0 fw-bold">@req.FullName</h6>
                                            <small class="badge @(req.Role == "Student" ? "bg-primary" : "bg-dark")">@req.Role</small>
                                            <small class="text-muted ms-1">@req.Department</small>
                                        </div>
                                        <span class="badge bg-secondary">Pending...</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB 3: MY CONNECTIONS -->
    @if (Model.ActiveTab == "connections")
    {
        @if (!Model.MyConnections.Any())
        {
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <div style="font-size: 50px;">👥</div>
                    <h5 class="text-muted mt-2">No connections yet</h5>
                    <p class="text-muted small">Go to the directory tab to find alumni and students to connect with!</p>
                    <a asp-action="Index" asp-route-tab="directory" class="btn btn-primary btn-sm">
                        Browse Directory
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var conn in Model.MyConnections)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card shadow-sm border-0 text-center p-3 h-100">
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(conn.ProfileImage))
                                {
                                    <img src="/uploads/@conn.ProfileImage" class="rounded-circle border mb-3"
                                         style="width: 75px; height: 75px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle @(conn.Role == "Student" ? "bg-primary" : "bg-dark") text-white d-inline-flex align-items-center justify-content-center mb-3"
                                         style="width: 75px; height: 75px; font-size: 26px; font-weight: bold;">
                                        @(conn.FullName.Length > 0 ? conn.FullName.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                }

                                <h5 class="fw-bold mb-1">@conn.FullName</h5>
                                <span class="badge @(conn.Role == "Student" ? "bg-primary" : "bg-dark") mb-2">@conn.Role</span>
                                <p class="text-muted small mb-1">@conn.Department</p>
                                
                                @if (!string.IsNullOrEmpty(conn.Details))
                                {
                                    <p class="text-secondary small fw-semibold mb-2">@conn.Details</p>
                                }

                                <!-- Notification badge showing who sent you a message -->
                                @if (conn.City == "new_msg")
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-danger py-1 px-3 fs-6">🔴 New Message</span>
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0">
                                <!-- Send Message Button -->
                                <a asp-controller="Message" asp-action="Chat" asp-route-userId="@conn.UserId"
                                   class="btn btn-primary btn-sm w-100 mb-2 fw-semibold">
                                    💬 Send Message
                                </a>

                                <form asp-action="RemoveConnection" method="post"
                                      onsubmit="return confirm('Remove this connection?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="connectionId" value="@conn.ConnectionId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                        Remove Connection
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

</div>