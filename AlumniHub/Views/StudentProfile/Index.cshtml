@model AlumniHub.Models.StudentProfile
@{
    ViewData["Title"] = "Student Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4>👤 Student Profile</h4>
                </div>
                <div class="card-body p-4">

                    <!-- Profile Image -->
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="/uploads/@Model.ProfileImage"
                                 class="rounded-circle shadow-sm"
                                 style="width:120px; height:120px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-inline-flex
                                align-items-center justify-content-center shadow-sm"
                                 style="width:120px; height:120px; font-size:45px;">
                                👤
                            </div>
                        }
                    </div>

                    <!-- Profile Info -->
                    <table class="table table-bordered">
                        <tr>
                            <th style="width:35%">Full Name</th>
                            <td>@Model.FullName</td>
                        </tr>
                        <tr>
                            <th>Department</th>
                            <td>@Model.Department</td>
                        </tr>
                        <tr>
                            <th>Batch Year</th>
                            <td>@Model.BatchYear</td>
                        </tr>
                        <tr>
                            <th>Bio</th>
                            <td>@(string.IsNullOrEmpty(Model.Bio) ? "No bio added yet" : Model.Bio)</td>
                        </tr>
                    </table>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="Edit" class="btn btn-warning text-dark fw-bold w-50">✏️ Edit Profile</a>
                        <form asp-action="Delete" method="post" class="w-50"
                              onsubmit="return confirm('Are you sure you want to delete your profile?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100">🗑️ Delete Profile</button>
                        </form>
                    </div>

                    <div class="mt-3">
                        <a asp-controller="StudentDashboard" asp-action="Index"
                           class="btn btn-outline-primary w-100">
                            🏠 Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>