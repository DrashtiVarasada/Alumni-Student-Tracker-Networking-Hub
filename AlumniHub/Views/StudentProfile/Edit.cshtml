@model AlumniHub.Models.StudentProfile
@{
    ViewData["Title"] = "Edit Student Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4>✏️ Edit Student Profile</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Department <span class="text-danger">*</span></label>
                            <input asp-for="Department" class="form-control" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Batch Year <span class="text-danger">*</span></label>
                            <input asp-for="BatchYear" class="form-control" type="number" />
                            <span asp-validation-for="BatchYear" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Bio</label>
                            <textarea asp-for="Bio" class="form-control" rows="3"
                                      placeholder="Tell us about yourself..."></textarea>
                        </div>

                        <!-- Profile Image Section -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Profile Image</label>
                            @if (!string.IsNullOrEmpty(Model.ProfileImage))
                            {
                                <div class="mb-2 p-2 border rounded bg-light d-flex align-items-center gap-3">
                                    <img src="/uploads/@Model.ProfileImage"
                                         style="width:70px; height:70px; object-fit:cover;"
                                         class="rounded-circle border" />
                                    <div>
                                        <div class="form-check">
                                            <input type="checkbox" name="removeImage" value="true" class="form-check-input" id="removeImageCheck" />
                                            <label class="form-check-label text-danger fw-semibold" for="removeImageCheck">
                                                🗑️ Remove this photo
                                            </label>
                                        </div>
                                        <small class="text-muted">Check box & click "Save Changes" to remove.</small>
                                    </div>
                                </div>
                            }
                            <label class="form-label small text-muted">
                                @(string.IsNullOrEmpty(Model.ProfileImage) ? "Upload photo (Optional)" : "Or upload new photo")
                            </label>
                            <input type="file" name="profileImage" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary w-50">Save Changes</button>
                            <a asp-action="Index" class="btn btn-outline-primary w-50">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}