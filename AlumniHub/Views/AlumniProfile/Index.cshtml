@model AlumniHub.Models.AlumniProfile
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4>🎓 Alumni Profile</h4>
                </div>
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="/uploads/@Model.ProfileImage"
                                 class="rounded-circle"
                                 style="width:120px; height:120px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-inline-flex
                                        align-items-center justify-content-center"
                                 style="width:120px; height:120px; font-size:40px;">
                                🎓
                            </div>
                        }
                    </div>

                    <table class="table table-bordered">
                        <tr>
                            <th>Full Name</th>
                            <td>@Model.FullName</td>
                        </tr>
                        <tr>
                            <th>Department</th>
                            <td>@Model.Department</td>
                        </tr>
                        <tr>
                            <th>Graduation Year</th>
                            <td>@Model.GraduationYear</td>
                        </tr>
                        <tr>
                            <th>Company</th>
                            <td>@Model.CurrentCompany</td>
                        </tr>
                        <tr>
                            <th>Designation</th>
                            <td>@Model.Designation</td>
                        </tr>
                        <tr>
                            <th>City</th>
                            <td>@Model.City</td>
                        </tr>
                        <tr>
                            <th>Bio</th>
                            <td>@Model.Bio</td>
                        </tr>
                    </table>

                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="Edit" class="btn btn-warning w-50">✏️ Edit Profile</a>
                        <form asp-action="Delete" method="post" class="w-50"
                              onsubmit="return confirm('Are you sure you want to delete your profile?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100">🗑️ Delete Profile</button>
                        </form>
                    </div>

                    <div class="mt-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark w-100">
                            🏠 Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>