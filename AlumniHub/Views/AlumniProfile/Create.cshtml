@model AlumniHub.Models.AlumniProfile
@{
    ViewData["Title"] = "Create Alumni Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4>🎓 Complete Your Alumni Profile</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Full Name</label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Computer Science" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Graduation Year</label>
                            <input asp-for="GraduationYear" class="form-control" type="number" placeholder="e.g. 2020" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Current Company</label>
                            <input asp-for="CurrentCompany" class="form-control" placeholder="e.g. Google" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Designation</label>
                            <input asp-for="Designation" class="form-control" placeholder="e.g. Software Engineer" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">City</label>
                            <input asp-for="City" class="form-control" placeholder="e.g. Mumbai" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Bio</label>
                            <textarea asp-for="Bio" class="form-control" rows="3"
                                placeholder="Share your journey..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Profile Image (Optional)</label>
                            <input type="file" name="profileImage" class="form-control" accept="image/*" />
                        </div>

                        <button type="submit" class="btn btn-dark w-100 mt-2">
                            Save Profile
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>