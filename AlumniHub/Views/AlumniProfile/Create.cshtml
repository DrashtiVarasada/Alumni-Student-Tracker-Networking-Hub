@model AlumniHub.Models.AlumniProfile
@{
    ViewData["Title"] = "Complete Alumni Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4>🎓 Complete Your Alumni Profile</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Priya Patel" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Department <span class="text-danger">*</span></label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Computer Engineering" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Graduation Year <span class="text-danger">*</span></label>
                            <input asp-for="GraduationYear" class="form-control" type="number" placeholder="e.g. 2022" />
                            <span asp-validation-for="GraduationYear" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Current Company (Optional)</label>
                            <input asp-for="CurrentCompany" class="form-control" placeholder="e.g. TCS / Infosys / Google" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Designation (Optional)</label>
                            <input asp-for="Designation" class="form-control" placeholder="e.g. Software Engineer" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">City (Optional)</label>
                            <input asp-for="City" class="form-control" placeholder="e.g. Ahmedabad / Pune" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Bio (Optional)</label>
                            <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Share your experience..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Profile Image (Optional)</label>
                            <input type="file" name="profileImage" class="form-control" accept="image/*" />
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-2 mt-3">Save Profile</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}